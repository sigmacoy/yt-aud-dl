{
  "manifest_version": 3,
  "name": "YouTube Audio Downloader",
  "version": "1.0.0",
  "description": "Download audio from YouTube videos as MP3",
  
  "permissions": [
    "activeTab",
    "downloads"
  ],
  
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:5001/*"
  ],
  
  "action": {
    "default_popup": "popup.html"
  }
}